<Window x:Class="HDMICapture.App.NumberedExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="採番出力" Height="560" Width="900" Background="#1E1E1E"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- プレビュー -->
        <Border Grid.Column="0" BorderThickness="1" BorderBrush="#4A4A4A" Background="Black" Margin="0,0,12,0">
            <Grid>
                <Image Name="imagePreview" Stretch="Uniform"/>
            </Grid>
        </Border>

        <!-- 設定・実行 -->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock Text="採番出力設定" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="対象件数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Name="labelTargetCount" Text="0件" FontSize="12" Margin="0,0,0,10"/>

            <TextBlock Text="出力先" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Name="labelOutputDir" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="フォント" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            <ComboBox Name="comboBoxFont" Height="24" Margin="0,4,0,10" SelectionChanged="ComboBoxFont_SelectionChanged"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="サイズ" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Name="labelFontScale" Text="1.0x" FontSize="11"/>
            </Grid>
            <Slider Name="sliderFontScale" Minimum="0.5" Maximum="3.0" Value="1.0" TickFrequency="0.1"
                     Margin="0,0,0,10" ValueChanged="Slider_ValueChanged"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="右マージン" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Name="labelMarginX" Text="20px" FontSize="11"/>
            </Grid>
            <Slider Name="sliderMarginX" Minimum="0" Maximum="150" Value="20" TickFrequency="1"
                     Margin="0,0,0,10" ValueChanged="Slider_ValueChanged"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="上マージン" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Name="labelMarginY" Text="20px" FontSize="11"/>
            </Grid>
            <Slider Name="sliderMarginY" Minimum="0" Maximum="150" Value="20" TickFrequency="1"
                     Margin="0,0,0,20" ValueChanged="Slider_ValueChanged"/>

            <ProgressBar Name="progressExport" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,4" Visibility="Collapsed"/>
            <TextBlock Name="labelProgress" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" Visibility="Collapsed"/>

            <Button Name="buttonExecute" Content="実行" Height="32" Click="ButtonExecute_Click"
                    Background="#4CAF50" Foreground="White" Margin="0,0,0,8"/>
            <Button Name="buttonClose" Content="閉じる" Height="28" Click="ButtonClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
