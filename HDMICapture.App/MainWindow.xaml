<Window x:Class="HDMICapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDMI Capture - NDI Sender" Height="800" Width="1550" Background="#F0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部: コントロール -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="12">
            <!-- ステータスバー -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Name="statusBorder" Background="#FF4444" CornerRadius="4" Padding="8,4" Width="140" HorizontalAlignment="Left">
                    <TextBlock Name="labelStatus" Text="● 停止中" FontSize="14" Foreground="White" FontWeight="Bold"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton Name="radioModeCapture" Content="キャプチャモード" GroupName="sourceMode" IsChecked="True"
                                 Checked="SourceMode_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Name="radioModeFile" Content="ファイルモード" GroupName="sourceMode"
                                 Checked="SourceMode_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton Name="radioModeStreaming" Content="ストリーミングモード" GroupName="sourceMode"
                                 Checked="SourceMode_Changed" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 中央: プレビュー + 検出レビューパネル -->
        <Grid Grid.Row="1" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Name="columnReviewPanel" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" BorderBrush="#CCCCCC" Background="#000000">
                <Grid>
                    <Image Name="imagePreview" Stretch="Uniform"/>
                </Grid>
            </Border>

            <!-- 検出レビューパネル(既定は非表示。「検出一覧」ボタンで開閉) -->
            <Border Name="borderReviewPanel" Grid.Column="1" Width="420" Margin="10,0,0,0"
                    BorderThickness="1" BorderBrush="#CCCCCC" Background="White" Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="検出一覧" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Name="buttonReviewClose" Content="閉じる" Width="60" Height="22" Click="ButtonReviewClose_Click" Margin="10,0,0,0" Padding="0" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Name="labelReviewFolder" Text="(未選択)" FontSize="10" Foreground="#666666" VerticalAlignment="Center" Width="230" TextTrimming="CharacterEllipsis"/>
                        <Button Name="buttonReviewSelectFolder" Content="フォルダ..." Height="22" Click="ButtonReviewSelectFolder_Click" Margin="4,0,0,0" Padding="4,0" FontSize="10"/>
                        <Button Name="buttonReviewRefresh" Content="更新" Height="22" Click="ButtonReviewRefresh_Click" Margin="4,0,0,0" Padding="4,0" FontSize="10"/>
                    </StackPanel>

                    <ListBox Name="listBoxDetections" Grid.Row="2" FontSize="11" Margin="0,0,0,8"
                              SelectionChanged="ListBoxDetections_SelectionChanged"
                              PreviewMouseLeftButtonUp="ListBoxDetections_PreviewMouseLeftButtonUp"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Name="radioViewPhoto" Content="比較明合成" GroupName="reviewViewMode" IsChecked="True" Checked="ViewMode_Changed" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Name="radioViewDiff" Content="差分" GroupName="reviewViewMode" Checked="ViewMode_Changed" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Name="radioViewMovie" Content="動画" GroupName="reviewViewMode" Checked="ViewMode_Changed" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="4" BorderBrush="#CCCCCC" BorderThickness="1" Background="Black">
                        <Grid>
                            <Image Name="imageReview" Stretch="Uniform"/>
                            <MediaElement Name="mediaReview" Visibility="Collapsed" Stretch="Uniform"
                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          MediaOpened="MediaReview_MediaOpened" MediaFailed="MediaReview_MediaFailed"/>
                        </Grid>
                    </Border>

                    <Button Name="buttonMarkFalsePositive" Grid.Row="6" Content="誤検知として削除" Click="ButtonMarkFalsePositive_Click"
                            Background="#F44336" Foreground="White" Padding="0,6" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 下部: NDI設定、デバイス選択、情報表示、コントロールボタン -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- NDI名設定(キャプチャモード) -->
            <StackPanel Name="panelNdiName" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Label Padding="0" VerticalAlignment="Center" FontSize="12">NDI:</Label>
                <TextBox Name="textBoxNDIName" Width="140" Height="28" Text="HDMI Capture" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" TextChanged="TextBoxNDIName_TextChanged"/>
            </StackPanel>

            <!-- デバイス選択(キャプチャモード) -->
            <StackPanel Name="panelDeviceSelect" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Label Padding="0" VerticalAlignment="Center" FontSize="12">デバイス:</Label>
                <ComboBox Name="comboBoxDevices" Width="180" Height="28" Margin="5,0,0,0" VerticalAlignment="Center"/>
                <CheckBox Name="checkBoxAudioEnabled" Content="音声" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0" Checked="CheckBoxAudioEnabled_Changed" Unchecked="CheckBoxAudioEnabled_Changed"/>
                <Button Name="buttonRefreshDevices" Content="更新" Width="70" Height="28" Click="ButtonRefreshDevices_Click" Margin="8,0,0,0" VerticalAlignment="Center" Padding="0"/>
            </StackPanel>

            <!-- ソースファイル・開始日時(ファイルモード) -->
            <StackPanel Name="panelFileSource" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Label Padding="0" VerticalAlignment="Center" FontSize="12">ファイル:</Label>
                <TextBox Name="textBoxSourceFile" Width="250" Height="28" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True"/>
                <Button Name="buttonSelectSourceFile" Content="選択..." Width="60" Height="28" Click="ButtonSelectSourceFile_Click" Margin="5,0,0,0" Padding="0"/>
                <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0">開始日時:</Label>
                <DatePicker Name="datePickerStartTime" Width="112" Height="28" Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox Name="textBoxStartTimeOfDay" Width="66" Height="28" Text="00:00:00" Padding="5" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- RTSP URL(ストリーミングモード) -->
            <StackPanel Name="panelRtspSource" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Label Padding="0" VerticalAlignment="Center" FontSize="12">RTSP URL:</Label>
                <TextBox Name="textBoxRtspUrl" Width="260" Height="28" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center"
                         Text="rtsp://" TextChanged="TextBoxRtspUrl_TextChanged"/>
            </StackPanel>

            <!-- 情報表示 -->
            <Grid Grid.Column="2" Margin="12,0">
                <TextBlock Name="labelInfo" Text="フレームレート: 0 FPS" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Name="labelCaptureInfo" Text="キャプチャー: 待機中" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- コントロールボタン -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="buttonStart" Content="開始" Width="80" Height="35" Click="ButtonStart_Click" Background="#4CAF50" Foreground="White" FontSize="13" Margin="5,0,0,0"/>
                <Button Name="buttonStop" Content="停止" Width="80" Height="35" Click="ButtonStop_Click" Background="#F44336" Foreground="White" FontSize="13" IsEnabled="False" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 流星検出設定 -->
        <Border Grid.Row="3" BorderThickness="1,1,1,0" BorderBrush="#CCCCCC" Margin="12,0,12,12" Padding="10,6" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <CheckBox Name="checkBoxMeteorDetection" Content="流星検出" VerticalAlignment="Center" FontSize="12"
                              Checked="CheckBoxMeteorDetection_Changed" Unchecked="CheckBoxMeteorDetection_Changed"/>
                    <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0">露出:</Label>
                    <ComboBox Name="comboBoxExposure" Width="60" Height="24" Margin="5,0,0,0" VerticalAlignment="Center" SelectedIndex="3" SelectionChanged="ComboBoxExposure_SelectionChanged">
                        <ComboBoxItem Content="1秒"/>
                        <ComboBoxItem Content="2秒"/>
                        <ComboBoxItem Content="3秒"/>
                        <ComboBoxItem Content="4秒"/>
                        <ComboBoxItem Content="5秒"/>
                    </ComboBox>
                </StackPanel>

                <!-- マスク設定 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Label Padding="0" VerticalAlignment="Center" FontSize="12">マスク:</Label>
                    <TextBlock Name="labelMaskStatus" Text="なし" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="5,0,0,0" Width="140"/>
                    <Button Name="buttonSelectMask" Content="選択..." Width="60" Height="24" Click="ButtonSelectMask_Click" Margin="5,0,0,0" Padding="0"/>
                    <Button Name="buttonClearMask" Content="クリア" Width="50" Height="24" Click="ButtonClearMask_Click" Margin="5,0,0,0" Padding="0"/>
                </StackPanel>

                <!-- 出力先 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Padding="0" VerticalAlignment="Center" FontSize="12">出力先:</Label>
                    <TextBox Name="textBoxMeteorOutputDir" Width="220" Height="24" Text="meteor_output" Padding="3" Margin="5,0,0,0" VerticalAlignment="Center" IsReadOnly="True"/>
                    <Button Name="buttonSelectOutputDir" Content="参照..." Width="60" Height="24" Click="ButtonSelectOutputDir_Click" Margin="5,0,0,0" Padding="0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Name="labelMeteorCount" Text="検出: 0件" FontSize="12" VerticalAlignment="Center"/>
                    <Button Name="buttonMeteorReview" Content="検出一覧..." Width="80" Height="24" Click="ButtonMeteorReview_Click" Margin="8,0,0,0" Padding="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- オーバーレイ描画設定 -->
        <Border Grid.Row="4" BorderThickness="1,0,1,1" BorderBrush="#CCCCCC" Margin="12,0,12,12" Padding="10,6" Background="White">
            <StackPanel Orientation="Horizontal">
                <Label Padding="0" VerticalAlignment="Center" FontSize="12">Overlay:</Label>

                <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0">Font</Label>
                <ComboBox Name="comboBoxOverlayFont" Width="130" Height="24" VerticalAlignment="Center" Margin="5,0,0,0" SelectedIndex="0" SelectionChanged="OverlayFont_SelectionChanged">
                    <ComboBoxItem Content="Simplex" Tag="HersheySimplex"/>
                    <ComboBoxItem Content="Plain" Tag="HersheyPlain"/>
                    <ComboBoxItem Content="Duplex" Tag="HersheyDuplex"/>
                    <ComboBoxItem Content="Complex" Tag="HersheyComplex"/>
                    <ComboBoxItem Content="Triplex" Tag="HersheyTriplex"/>
                    <ComboBoxItem Content="Complex Small" Tag="HersheyComplexSmall"/>
                    <ComboBoxItem Content="Script Simplex" Tag="HersheyScriptSimplex"/>
                    <ComboBoxItem Content="Script Complex" Tag="HersheyScriptComplex"/>
                </ComboBox>

                <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0">Size</Label>
                <Slider Name="sliderOverlayFontScale" Width="100" Minimum="0.5" Maximum="3.0" Value="1.0"
                         TickFrequency="0.1" VerticalAlignment="Center" Margin="5,0,0,0" ValueChanged="OverlayStyle_Changed"/>
                <TextBlock Name="labelOverlayFontScale" Text="1.0x" FontSize="11" Width="34" VerticalAlignment="Center" Margin="4,0,0,0"/>

                <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="14,0,0,0">Margin X</Label>
                <Slider Name="sliderOverlayMarginX" Width="100" Minimum="0" Maximum="150" Value="12"
                         TickFrequency="1" VerticalAlignment="Center" Margin="5,0,0,0" ValueChanged="OverlayStyle_Changed"/>
                <TextBlock Name="labelOverlayMarginX" Text="12px" FontSize="11" Width="34" VerticalAlignment="Center" Margin="4,0,0,0"/>

                <Label Padding="0" VerticalAlignment="Center" FontSize="12" Margin="14,0,0,0">Margin Y</Label>
                <Slider Name="sliderOverlayMarginY" Width="100" Minimum="0" Maximum="150" Value="12"
                         TickFrequency="1" VerticalAlignment="Center" Margin="5,0,0,0" ValueChanged="OverlayStyle_Changed"/>
                <TextBlock Name="labelOverlayMarginY" Text="12px" FontSize="11" Width="34" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
