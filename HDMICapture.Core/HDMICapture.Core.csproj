<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Media Capture for video input -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- 採番出力機能で、OSにインストールされた実フォントをMatへ合成描画するために使用。
         WPFのRenderTargetBitmap/DrawingVisualはSTAスレッドを要求し、バックグラウンド
         スレッド(Task.Run)からの動画一括書き出しと相性が悪いため、スレッド制約のない
         GDI+(System.Drawing.Common)を使う。 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NDI SDK reference -->
    <ProjectReference Include="..\..\Examples\C#\NDILibDotNet2\NDILibDotNet2.csproj" />
  </ItemGroup>

</Project>
